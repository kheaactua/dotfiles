; Config setup for development.  Tool related config options were moved to
; gitconfig-tools so it's easier to not map them in containers

[includeIf "gitdir:~/workspace/capi/**/"]
  path = ~/.gitconfig-work
; Work-specific includeIf rules live in dotfiles-secret (ignored if absent)
[include]
  path = ~/.gitconfig-work-paths
[includeIf "gitdir:/tmp/manifest/**/"]
  path = ~/.gitconfig-work
[includeIf "gitdir:/tmp/vsomeip-source/**/"]
  path = ~/.gitconfig-work
[includeIf "gitdir:/src/**/"]
  path = ~/.gitconfig-work
[includeIf "gitdir:/f/**/*"]
  path = ~/.gitconfig-work
[includeIf "gitdir:/f/**/"]
  path = 	~/.gitconfig-work
; [includeIf "gitdir:/tmp/**/"]
;   path = 	~/.gitconfig-work
[includeIf "gitdir:~/.conan*/**/"]
  path = 	~/.gitconfig-work
[url "https://github.com"]
  insteadOf = ssh://github.com

[core]
  quotepath = false
  commitGraph = true
  commentchar = @
  pager = delta
[gc]
  writeCommitGraph = true
[merge]
  tool = diffview
[color]
  ui = auto
[push]
  default = current
[pull]
  rebase = true
[fetch]
  prune = true
[rebase]
  autoStash = true
  ; autoSquash = true

[diff]
  colorMoved = default

[uploadpack]
  allowFilter = true

[init]
  defaultBranch = main

[merge]
  conflictStyle = diff3

[difftool]
  # Run the difftool immediately, don't ask 'are you sure' each time.
  prompt = false

[protocol]
	allow = always

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection

[merge]
    conflictStyle = zdiff3

